# Copy to deploy/postgres.env (chmod 600) and set a real password. run.sh and GP/backend/run.sh
# source deploy/postgres.env when it exists; docker compose -f deploy/docker-compose.postgres.yml
# reads POSTGRES_PASSWORD from it (--env-file).
POSTGRES_PASSWORD=change-me
PENSION_DATABASE_URL=postgresql://pension:change-me@127.0.0.1:5433/pension
# The test suites create and drop schemas here; a separate database so a test never touches live rows.
PENSION_TEST_DATABASE_URL=postgresql://pension:change-me@127.0.0.1:5433/pension_test
