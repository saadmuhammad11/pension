# /etc/pension/pension.env  (root:pension, mode 640) -- docs/DEPLOYMENT.md §3.4, §11.1
# Copy, fill in every CHANGE_ME, and keep it out of any repository.

# ---- The switch ------------------------------------------------------------------------------
# production: no API docs, no open sign-in sheet, no shared seed password, password change at
# first sign-in, portal on loopback behind nginx, /gpf/ pass-through off (api/settings.py).
PENSION_ENV=production

# ---- Pension API (:8110, loopback only) -------------------------------------------------------
PENSION_API_BIND=127.0.0.1
# The database (9 Oct 2026): PostgreSQL. PENSION_DB is the SQLite fallback, used only when the URL is unset.
PENSION_DATABASE_URL=postgresql://pension:CHANGE-ME@127.0.0.1:5432/pension
# PENSION_DB=/var/lib/pension/artifacts/portal.sqlite3     # only for a box with no PostgreSQL
# PENSION_TEST_DATABASE_URL: the test suites' database (tools/run-tests.sh); never set for a server
# openssl rand -base64 48
PENSION_JWT_SECRET=CHANGE_ME
PENSION_PUBLIC_HOST=CHANGE_ME_pension.agpunjab.local
# Only needed for a development server on another origin; leave empty behind nginx.
PENSION_CORS_ORIGINS=
# Pages one uploaded PDF may have, and pages one case bundle may have in all.
PENSION_MAX_PAGES=500
PENSION_MAX_BUNDLE_PAGES=1000
# Verifications on the models at once; the rest wait, still "queued".
PENSION_MAX_CONCURRENT_RUNS=2
# A password someone else set -- the seed, or an administrator's reset -- must be replaced at
# first sign-in. On in production; =1 turns it on for a trial, =0 off anywhere (api/settings.py).
# PENSION_FORCE_PASSWORD_CHANGE=

# Where the deployment's own settings are read from by code NOT started by systemd
# (tools/bench.py, a pipeline module run by hand). Unset means /etc/pension/pension.env.
# PENSION_ENV_FILE=

# One verification may run this long before it is failed and its slot freed.
PENSION_RUN_DEADLINE_MIN=90
# A GP Fund examination may run this long before the case is failed.
PENSION_GPF_JOB_DEADLINE_MIN=120
# Seconds one poppler call (pdfinfo, pdftoppm) may take on a page bundle.
PENSION_PDF_TOOL_TIMEOUT=300
# Uploads and verifications are refused (507) below this much free disk for case files.
PENSION_MIN_FREE_GB=5
# Run folders that never produced a report and belong to no case are removed after this many days.
PENSION_RUN_ORPHAN_DAYS=7
# Minutes a finished run stays in the API's memory before it is served from disk instead.
PENSION_RUN_REGISTRY_KEEP_MIN=60
# Seconds between syncs with the pipeline and GP Fund on the request paths (every browser polls
# every 3 s); the reconciler's own timer always syncs.
PENSION_SYNC_MIN_INTERVAL_S=1.0
# Never set in production: PENSION_SEED_PASSWORD, PENSION_TRUST_PORT_HEADER, PENSION_API_DOCS,
# PENSION_DEPARTMENT_PORTS (one portal per department on its own port: the trial's early layout),
# PENSION_IMPORT_LEGACY (import the old register's runs as cases at start-up: a one-off migration).

# ---- Model services (F4) -------------------------------------------------------------------------
PENSION_VISION_URL=http://127.0.0.1:8011/v1/chat/completions
PENSION_OCR_URL=http://127.0.0.1:8012/v1/chat/completions
PENSION_EMBED_URL=http://127.0.0.1:8093/v1/embeddings
PENSION_RERANK_URL=http://127.0.0.1:8094/v1/rerank
# The model servers' key: the same value as VLLM_API_KEY in /etc/pension/models.env.
PENSION_MODEL_API_KEY=CHANGE_ME

# ---- Portal server (:5184) ----------------------------------------------------------------------
PENSION_PORTAL_BIND=127.0.0.1
# The nginx on this machine; add its address if nginx runs elsewhere.
PENSION_TRUSTED_PROXIES=127.0.0.1
PENSION_PORTAL_DIST=/opt/pension/current/portals/dist
PENSION_API_URL=http://127.0.0.1:8110
PENSION_GPF_URL=http://127.0.0.1:8201
PENSION_GPF_TIMEOUT=60
# `python3 -m api.check_inventory` (go-live checklist): the password its accounts sign in with (the
# trial's 1234 by default; production refuses that, so set a real one) and the accounts, as
# "username:ROLE,username:ROLE" -- one reviewer and the administrator.
# PENSION_CHECK_PASSWORD=
# PENSION_CHECK_USERS=ag.reviewer:AG_REVIEWER,admin:ADMIN
# /gpf/ (the GP Fund frame on the AG's case screen) needs the portal's sign-in cookie. Leave unset;
# "open" would drop the check and is ignored in production.
# PENSION_GPF_PROXY=

# ---- GP Fund (:8201, loopback only) -------------------------------------------------------------
# Same database as the pension API: the URL above (a SQLite path still works where there is no PostgreSQL).
GPF_DB=postgresql://pension:CHANGE-ME@127.0.0.1:5432/pension
GPF_DATA_DIR=/var/lib/pension/gpf
GPF_VLLM_URL=http://127.0.0.1:8011/v1
GPF_VLLM_TIMEOUT=180
# The model servers' key for the GP Fund module's own calls; defaults to PENSION_MODEL_API_KEY.
# GPF_VLLM_API_KEY=
# Several model servers, comma-separated, where the module should look for its vision and
# reasoning models (vision, OCR, embedding on this box; reasoning on another). Leave unset for one.
# GPF_VLLM_URLS=http://127.0.0.1:8011,http://127.0.0.1:8012,http://127.0.0.1:8093
# Served model names, where they differ from what the servers advertise.
# GPF_VLLM_VISION_MODEL=
# GPF_VLLM_REASONING_MODEL=
# Never set in production: GPF_API_DOCS (the module's /docs page; off in production, as the API's).

# The key the pension portal and the GP Fund bridge present on every /api request to the module,
# which has no sign-in of its own and must answer nothing else (audit 13 Oct 2026, C-04). Leave it
# unset where both run on one box: they share artifacts/.gpf_api_key, created on first use with
# owner-only access. Set it on BOTH sides, to the same value, when they run on different hosts.
# GPF_API_KEY=

# The old single-screen register's writes (POST /api/runs, /api/runs/{id}/decision): off in production
# (audit 7 Oct 2026, N23); 1 turns them on, 0 turns them off in a trial.
# PENSION_LEGACY_REGISTER_WRITES=0
# deploy/pg-backup.sh (shell, not the API) reads PENSION_BACKUP_DIR for its nightly dumps (default
# artifacts/backups/pg; /var/backups/pension/pg on production) and PENSION_BACKUP_KEEP for how many to keep (30).
