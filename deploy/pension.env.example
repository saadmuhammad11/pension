# /etc/pension/pension.env  (root:pension, mode 640) -- docs/DEPLOYMENT.md §3.4, §11.1
# Copy, fill in every CHANGE_ME, and keep it out of any repository.

# ---- The switch ------------------------------------------------------------------------------
# production: no API docs, no open sign-in sheet, no shared seed password, password change at
# first sign-in, portal on loopback behind nginx, /gpf/ pass-through off (api/settings.py).
PENSION_ENV=production
# Is anything terminating TLS in front of these services? Unset means "whatever production
# says", which is what a correct deployment wants: nginx with a certificate, services on
# loopback. Set it to 0 only where that is not yet true, and expect the start-up warning.
#
# The GP Fund frame's cookie turns on it. Issued Secure, a browser silently discards it over
# plain HTTP -- it does not warn and never sends it back -- so the frame refuses an officer
# who opened the case correctly. 0 weakens nothing TLS was protecting, because there is none.
# PENSION_BEHIND_TLS=

# ---- Pension API (:8110, loopback only) -------------------------------------------------------
PENSION_API_BIND=127.0.0.1
# The database (9 Oct 2026): PostgreSQL. PENSION_DB is the SQLite fallback, used only when the URL is unset.
PENSION_DATABASE_URL=postgresql://pension:CHANGE-ME@127.0.0.1:5432/pension
# PENSION_DB=/var/lib/pension/artifacts/portal.sqlite3     # only for a box with no PostgreSQL
# PENSION_TEST_DATABASE_URL: the test suites' database (tools/run-tests.sh); never set for a server
# openssl rand -base64 48
PENSION_JWT_SECRET=CHANGE_ME
PENSION_PUBLIC_HOST=CHANGE_ME_pension.agpunjab.local
# Only needed for a development server on another origin; leave empty behind nginx.
PENSION_CORS_ORIGINS=
# Pages one uploaded PDF may have, and pages one case bundle may have in all.
PENSION_MAX_PAGES=500
PENSION_MAX_BUNDLE_PAGES=1000
# The most one request body may be, in MB. Refused from the Content-Length before a byte is
# read, by the portal's proxy and by the API. 40 since 20 Oct 2026 (was 520): the largest real
# bundle measured on the box is 35.0 MB, a 78-page scan, so this leaves 12.5% and refuses a
# case much past ~90 pages. Raise it here if a long service record needs it, and raise
# client_max_body_size in deploy/nginx/pension.conf to match or nginx refuses first.
PENSION_MAX_UPLOAD_MB=40
# Verifications on the models at once; the rest wait, still "queued".
PENSION_MAX_CONCURRENT_RUNS=2
# Model requests one run makes at once. Both were measured on the DGX Spark; the Ascend NPU
# server (18 Oct 2026) has not been swept yet, so these are the old machine's numbers until it
# is. Raise them together with an eye on the servers' own counters -- /api/gpu reports
# waiting_capacity, and anything above zero means requests are queued inside vLLM for a
# scheduler slot, which is where more concurrency stops buying throughput.
#
# NOTE these multiply with PENSION_MAX_CONCURRENT_RUNS: peak requests at the server is
# runs x per-run concurrency. Eight runs at assertion concurrency 8 is 64 in flight.
# PENSION_IDENTIFY_CONCURRENCY=4
# PENSION_ASSERTION_CONCURRENCY=2
# PENSION_VERIFY_CONCURRENCY=16
# PENSION_ASSEMBLE_OCR_CONCURRENCY=16
# Stage 6's OCR sweeps -- recoveries off every LPC, and the attestation second reader.
# Both read one page at a time until 21 Oct 2026, 156-211s of a 221-268s case at a mean
# concurrency of 1.0 while the vision reader beside them held 4-6. These go to the
# PaddleOCR server, which does not compete with the vision model but has only one chip:
# ten pages took 31.7s sequentially, 17.9s at 4, and 17.6s at 8. It saturates at four.
# PENSION_OCR_SWEEP_CONCURRENCY=4
# Whether a resubmission may reuse the earlier round's reading of the pages it has not
# changed. OFF by the office's decision of 23 Oct 2026: every verify reads every page
# again. It saved six to twelve minutes on a case returned for one certificate, and it
# cost this -- a carried page keeps the reading it was given the FIRST time, right or
# wrong, so a second look is a second chance at a page and a fix to the reader reaches an
# old page only on a run that re-reads it. Set to 1 to have it back.
# It governs both products, by two mechanisms: a pension run reuses the earlier round's
# report (pipeline.carryover), and a GP Fund claim is read by the module, which caches each
# page under a scope the portal sends only while this is on. The GP Fund half was missed on
# the day and went on reusing pages until later that evening, so re-examining an unchanged
# claim finished in half a second having read none of it.
# PENSION_CARRYOVER=0
# Signature blocks read at once. Each is one small vision call on a page nothing else
# needs, and the stage cannot finish without all of them. They were read one at a time
# until 21 Oct 2026: on a three-form bundle 197.8s, 201.6s and 205.3s, one request in
# flight throughout, 11.5s of a 209s case. Four is enough; a bundle rarely carries more
# than four prescribed forms.
# PENSION_SIGNATURE_CONCURRENCY=4
# Pages rendered at once, and the whole process's budget for it. Rendering is local CPU, so
# the budget is shared across every run rather than set per run: one case gets the box, eight
# share it. Unset means this machine's core count.
# PENSION_RENDER_CONCURRENCY=
# PENSION_RENDER_WORKERS=

# Reads of a page's two candidate rotations, in flight at once (extraction/upright.py). Each
# candidate is asked JUDGE_READS times and must answer the same every time; 1 asks them one
# after another, as before 20 Oct 2026.
# PENSION_JUDGE_CONCURRENCY=6
# The two attestation bands of one page, read at once (extraction/ocr.py). 1 disables it.
# PENSION_ATTESTATION_BAND_CONCURRENCY=2

# Discourages the OCR reader from repeating itself. FREE-FORM TEXT ONLY -- it is never set on
# the vision model, whose answers are JSON and must repeat their keys. 0.6 measured 20 Oct 2026:
# 70% of reads were repetition loops that spent the whole token budget on one line and were
# then discarded as evidence.
# PENSION_OCR_FREQUENCY_PENALTY=0.6

# A password someone else set -- the seed, or an administrator's reset -- must be replaced at
# first sign-in. On in production; =1 turns it on for a trial, =0 off anywhere (api/settings.py).
# PENSION_FORCE_PASSWORD_CHANGE=

# Where the deployment's own settings are read from by code NOT started by systemd
# (tools/bench.py, a pipeline module run by hand). Unset means /etc/pension/pension.env.
# PENSION_ENV_FILE=

# ---- Logs -----------------------------------------------------------------------------------
# Every stage, model call and wait of a run, one JSON object per line, in the run's own
# directory: artifacts/run-<run_id>/calls.jsonl. 0 turns it off.
# PENSION_CALL_LOG=1
# The same records in the run_timings table. OFF since 20 Oct 2026: logs do not belong in the
# case database -- the store that holds the cases is the one that has to be backed up and
# restored, and an append-only record read by eye and by grep has no business in it. Every
# reader goes to the files now: summary(), --timeline, --list and tools/bench.py.
# =1 puts the writes back for a deployment that has something pointed at the table. The table
# and its migration stay either way; the rows already there are a record of real runs.
# PENSION_TIMING_DB=0
# The GP Fund module's own log, the same two switches. Its lines go to GPF_DATA_DIR/jobs/.
# GPF_CALL_LOG=1
# GPF_TIMING_DB=0
# Where run directories live, for the call log. Unset means the installation root; a test
# redirects it so fixture runs do not write into the live artefacts directory.
# PENSION_RUN_ROOT=

# One verification may run this long before it is failed and its slot freed.
PENSION_RUN_DEADLINE_MIN=90
# A GP Fund examination may run this long before the case is failed.
PENSION_GPF_JOB_DEADLINE_MIN=120
# Seconds one poppler call (pdfinfo, pdftoppm) may take on a page bundle.
PENSION_PDF_TOOL_TIMEOUT=300
# Uploads and verifications are refused (507) below this much free disk for case files.
PENSION_MIN_FREE_GB=5
# Run folders that never produced a report and belong to no case are removed after this many days.
PENSION_RUN_ORPHAN_DAYS=7
# Minutes a finished run stays in the API's memory before it is served from disk instead.
PENSION_RUN_REGISTRY_KEEP_MIN=60
# Seconds between syncs with the pipeline and GP Fund on the request paths (every browser polls
# every 3 s); the reconciler's own timer always syncs.
PENSION_SYNC_MIN_INTERVAL_S=1.0
# Never set in production: PENSION_SEED_PASSWORD, PENSION_TRUST_PORT_HEADER, PENSION_API_DOCS,
# PENSION_DEPARTMENT_PORTS (one portal per department on its own port: the trial's early layout),
# PENSION_IMPORT_LEGACY (import the old register's runs as cases at start-up: a one-off migration).

# ---- Model services (F4) -------------------------------------------------------------------------
PENSION_VISION_URL=http://127.0.0.1:8011/v1/chat/completions
PENSION_OCR_URL=http://127.0.0.1:8012/v1/chat/completions
PENSION_EMBED_URL=http://127.0.0.1:8093/v1/embeddings
PENSION_RERANK_URL=http://127.0.0.1:8094/v1/rerank
# The model servers' key: the same value as VLLM_API_KEY in /etc/pension/models.env.
PENSION_MODEL_API_KEY=CHANGE_ME

# ---- Portal server (:5184) ----------------------------------------------------------------------
PENSION_PORTAL_BIND=127.0.0.1
# The nginx on this machine; add its address if nginx runs elsewhere.
PENSION_TRUSTED_PROXIES=127.0.0.1
PENSION_PORTAL_DIST=/opt/pension/current/portals/dist
PENSION_API_URL=http://127.0.0.1:8110
PENSION_GPF_URL=http://127.0.0.1:8201
PENSION_GPF_TIMEOUT=60
# `python3 -m api.check_inventory` (go-live checklist): the password its accounts sign in with (the
# trial's 1234 by default; production refuses that, so set a real one) and the accounts, as
# "username:ROLE,username:ROLE" -- one reviewer and the administrator.
# PENSION_CHECK_PASSWORD=
# PENSION_CHECK_USERS=ag.reviewer:AG_REVIEWER,admin:ADMIN
# /gpf/ (the GP Fund frame on the AG's case screen) needs the portal's sign-in cookie. Leave unset;
# "open" would drop the check and is ignored in production.
# PENSION_GPF_PROXY=

# ---- GP Fund (:8201, loopback only) -------------------------------------------------------------
# Same database as the pension API: the URL above (a SQLite path still works where there is no PostgreSQL).
GPF_DB=postgresql://pension:CHANGE-ME@127.0.0.1:5432/pension
GPF_DATA_DIR=/var/lib/pension/gpf
# EVERY model server the deployment has, comma-separated. The module probes each and binds a
# role by the model name it finds: a *-vl/vision model to vision and reasoning, a paddle/ocr
# model to OCR, an *embed* model to embeddings.
#
# Set this, not just GPF_VLLM_URL below. Naming one server leaves the embedding role unbound,
# and GP Fund's citations then fall back to keyword search and say nothing about it -- which
# is what the live box did until 20 Oct 2026. The addresses here were the loopback ports from
# when the models ran on the application box; they moved to the NPU server on 18 Oct.
GPF_VLLM_URLS=http://10.28.8.143:8000,http://10.28.8.143:8001,http://10.28.8.143:8093
# The single-server fallback, used only when GPF_VLLM_URLS is unset. With or without /v1:
# the client appends its own /v1 and accepts either spelling.
GPF_VLLM_URL=http://10.28.8.143:8000
GPF_VLLM_TIMEOUT=180
# Pages of one claim read at once. Each page is two model calls (classify, then extract for
# whatever classify said it is) and a local barcode decode, and no page needs anything another
# page produced. Measured 20 Oct 2026 on a five-page claim: 82.5s serial, 44.2s at 4, which is
# the cost of its slowest page and nothing else -- so raising this further buys little until
# claims are longer than the pool is wide.
#
# 4, not more: these servers also carry the pension pipeline, which runs up to
# PENSION_MAX_CONCURRENT_RUNS cases at PENSION_IDENTIFY_CONCURRENCY each. 1 restores the
# serial read exactly.
# GPF_READ_CONCURRENCY=4
# The model servers' key for the GP Fund module's own calls; defaults to PENSION_MODEL_API_KEY.
# GPF_VLLM_API_KEY=
# Served model names, where they differ from what the servers advertise.
# GPF_VLLM_VISION_MODEL=
# GPF_VLLM_REASONING_MODEL=
# Never set in production: GPF_API_DOCS (the module's /docs page; off in production, as the API's).

# The key the pension portal and the GP Fund bridge present on every /api request to the module,
# which has no sign-in of its own and must answer nothing else (audit 13 Oct 2026, C-04). Leave it
# unset where both run on one box: they share artifacts/.gpf_api_key, created on first use with
# owner-only access. Set it on BOTH sides, to the same value, when they run on different hosts.
# GPF_API_KEY=

# The old single-screen register's writes (POST /api/runs, /api/runs/{id}/decision): off in production
# (audit 7 Oct 2026, N23); 1 turns them on, 0 turns them off in a trial.
# PENSION_LEGACY_REGISTER_WRITES=0
# The nightly dump is deploy/backup-db.sh, run by pension-backup.timer, and it is configured in
# /etc/pension/backup.conf rather than here -- it needs no database URL, dumping as the postgres
# system user over the local socket (docs/DEPLOYMENT.md §7.2).
