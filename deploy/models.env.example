# /etc/pension/models.env -- read by vllm-qwen3-vl, paddleocr-vl and qwen3-embedding.service.
# Install as root:tmc, mode 640 (the model units run as tmc). Keep it out of any repository.
#
# The key every /v1 request to the model servers must carry (audit 6 Oct 2026, item 7). The
# launchers refuse to start without one of 32+ characters. Generate with:
#   openssl rand -base64 48
# and put the same value in /etc/pension/pension.env as PENSION_MODEL_API_KEY.
VLLM_API_KEY=CHANGE_ME
