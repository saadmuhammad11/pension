# /etc/pension/models.env (Ascend) -- read by the deploy/ascend/serve-*.sh scripts.
# Copy to /etc/pension/models.env and fill in. DRAFT values; set per the vendor's chip (README §2).

# Shared API key for all three vLLM servers. Generate: openssl rand -base64 48
VLLM_API_KEY=CHANGE_ME

# Vision precision + topology (README §2):
#   64G cards (910B / Atlas 800 A2/A3): VISION_QUANT=bf16, ASCEND_TP=2
#   950DT (96G):                        VISION_QUANT=w8a8, ASCEND_TP=8
VISION_QUANT=bf16
ASCEND_TP=2
ASCEND_DEVICES=0,1          # NPU ids for the vision server; count must equal ASCEND_TP

# OCR and embedding placement (each on its own NPU by default)
OCR_TP=1
OCR_DEVICES=2
EMBED_TP=1
EMBED_DEVICES=3
