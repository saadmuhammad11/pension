[Unit]
Description=GP Fund module (:8201, loopback)
Documentation=file:/opt/pension/current/docs/DEPLOYMENT.md
# After the vision model: started before it, the module falls back to stub mode and reads nothing.
After=network-online.target vllm-qwen3-vl.service pension-api.service

[Service]
Type=simple
User=pension
Group=pension
WorkingDirectory=/opt/pension/current/GP/backend
EnvironmentFile=/etc/pension/pension.env
Environment=HOME=/var/lib/pension
ExecStart=/opt/pension/venv/bin/python3 -m uvicorn gpf.api:app --host 127.0.0.1 --port 8201
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pension /var/log/pension
PrivateTmp=true
# Hardening (audit 6 Oct 2026, L10): a Python service that needs the network, its data folder
# and nothing else. Devices stay visible for nvidia-smi (/api/gpu); W^X is not enforced because
# numpy/OpenCV load code pages at run time.
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# A blocked call fails with EPERM instead of killing the process with SIGSYS (review C5, 9 Oct 2026):
# LibreOffice and the OCR path probe calls the filter refuses, and a refused call they can handle.
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

[Install]
WantedBy=multi-user.target
