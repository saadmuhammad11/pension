[Unit]
Description=AG Punjab Pension portal server (:5184, loopback behind nginx)
Documentation=file:/opt/pension/current/docs/DEPLOYMENT.md
After=pension-api.service
Requires=pension-api.service

[Service]
Type=simple
User=pension
Group=pension
WorkingDirectory=/opt/pension/current
EnvironmentFile=/etc/pension/pension.env
ExecStart=/opt/pension/venv/bin/python3 -m api.portal_server
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
# The portal server reads the database for the sign-in sheet in the trial only; read-only here.
ReadOnlyPaths=/var/lib/pension
ReadWritePaths=/var/log/pension
PrivateTmp=true
# Hardening (audit 6 Oct 2026, L10): a Python service that needs the network, its data folder
# and nothing else. Devices stay visible for nvidia-smi (/api/gpu); W^X is not enforced because
# numpy/OpenCV load code pages at run time.
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

[Install]
WantedBy=multi-user.target
