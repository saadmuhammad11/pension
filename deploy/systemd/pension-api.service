[Unit]
Description=AG Punjab Pension API (:8110)
Documentation=file:/opt/pension/current/docs/DEPLOYMENT.md
After=network-online.target vllm-qwen3-vl.service
Wants=network-online.target

[Service]
Type=simple
User=pension
Group=pension
WorkingDirectory=/opt/pension/current
EnvironmentFile=/etc/pension/pension.env
# LibreOffice (Word uploads -> PDF) needs a writable home; /opt is read-only under ProtectSystem.
Environment=HOME=/var/lib/pension
ExecStart=/opt/pension/venv/bin/python3 -m api.server 8110
Restart=always
RestartSec=5
# An AI run in progress is lost on stop: check for active runs before any restart (DEPLOYMENT.md §10).
TimeoutStopSec=60
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pension /var/log/pension
PrivateTmp=true
# Hardening (audit 6 Oct 2026, L10): a Python service that needs the network, its data folder
# and nothing else. Devices stay visible for nvidia-smi (/api/gpu); W^X is not enforced because
# numpy/OpenCV load code pages at run time.
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

[Install]
WantedBy=multi-user.target
